# Copy to .env and insert your key. Do not commit .env.
GOOGLE_API_KEY=
GIT_AGENT_MODEL=gemini-3.6-flash
# Google recommends 1.0 for Gemini 3; lower values can degrade reasoning.
GIT_AGENT_TEMPERATURE=1.0

# GitHub MCP Server running locally in Streamable HTTP mode.
# In Docker or Kubernetes, use the MCP service's network name instead of 127.0.0.1.
GITHUB_MCP_URL=http://127.0.0.1:8082/
# A PAT from the GitHub instance configured on the MCP server (GITHUB_HOST).
# Use a credential limited to the repositories and read permissions needed.
GITHUB_MCP_TOKEN=
