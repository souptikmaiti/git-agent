# Copy to .env and insert your key. Do not commit .env.
GOOGLE_API_KEY=
GIT_AGENT_MODEL=gemini-3.6-flash
# Google recommends 1.0 for Gemini 3; lower values can degrade reasoning.
GIT_AGENT_TEMPERATURE=1.0

# Optional: use a GitMCP endpoint scoped to one public GitHub repository.
# GITMCP_URL=https://gitmcp.io/OWNER/REPO
